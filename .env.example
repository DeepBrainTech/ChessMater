# Copy to .env and set actual values before starting production.
POSTGRES_PASSWORD=
CHESSMATER_JWT_SECRET=
CHESSMATER_SESSION_JWT_SECRET=
# Public browser-facing URLs; Vite embeds these when the image is built.
CHESSMATER_API_URL=
PORTAL_API_URL=https://api.deepbraintechnology.com
PORTAL_URL=https://deepbraintechnology.com
# Host ports for an HTTPS reverse proxy.
CHESSMATER_WEB_PORT=8080
CHESSMATER_API_PORT=3002
